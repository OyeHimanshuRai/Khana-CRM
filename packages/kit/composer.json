{
    "name": "khana/kit",
    "description": "Shared plumbing for the Khana services: tenancy, signed events, money and business days.",
    "version": "0.1.0",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "opis/json-schema": "^2.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Khana\\Kit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Khana\\Kit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Khana\\Kit\\KitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
