{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.khana.local/events/crm.sale.returned.v1.json",
  "title": "crm.sale.returned v1",
  "description": "A customer return was approved. Stock goes back only for lines marked back_to_stock, which CRM offers for packaged goods only.",
  "allOf": [{ "$ref": "envelope.json" }],
  "properties": {
    "type": { "const": "crm.sale.returned" },
    "version": { "const": 1 },
    "source": { "const": "crm" },
    "tenant_id": { "$ref": "defs.json#/$defs/ulid" },
    "outlet_id": { "$ref": "defs.json#/$defs/ulid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_id", "sale_id", "business_date", "lines"],
      "properties": {
        "return_id": { "$ref": "defs.json#/$defs/ulid" },
        "sale_id": { "$ref": "defs.json#/$defs/ulid" },
        "business_date": { "$ref": "defs.json#/$defs/businessDate" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_id", "qty", "back_to_stock"],
            "properties": {
              "line_id": {
                "$ref": "defs.json#/$defs/ulid",
                "description": "The sale line being returned."
              },
              "qty": { "$ref": "defs.json#/$defs/positiveQuantity" },
              "back_to_stock": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
