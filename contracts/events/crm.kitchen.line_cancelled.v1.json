{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.khana.local/events/crm.kitchen.line_cancelled.v1.json",
  "title": "crm.kitchen.line_cancelled v1",
  "description": "A kitchen line was cancelled. Before cooking started ERP reverses it; from preparing onwards the ingredients are booked as wastage. Carries the item so ERP can do either without having seen the line before.",
  "allOf": [{ "$ref": "envelope.json" }],
  "properties": {
    "type": { "const": "crm.kitchen.line_cancelled" },
    "version": { "const": 1 },
    "source": { "const": "crm" },
    "tenant_id": { "$ref": "defs.json#/$defs/ulid" },
    "outlet_id": { "$ref": "defs.json#/$defs/ulid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "line_id", "item_id", "variant_id", "option_ids", "qty", "stage_reached", "reason"],
      "properties": {
        "order_id": { "$ref": "defs.json#/$defs/ulid" },
        "line_id": { "$ref": "defs.json#/$defs/ulid" },
        "item_id": { "$ref": "defs.json#/$defs/ulid" },
        "variant_id": { "$ref": "defs.json#/$defs/nullableUlid" },
        "option_ids": { "$ref": "defs.json#/$defs/ulidList" },
        "qty": { "$ref": "defs.json#/$defs/positiveQuantity" },
        "stage_reached": { "$ref": "defs.json#/$defs/kitchenStage" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
