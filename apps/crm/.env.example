APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Live updates (§8, §9)
# ----------------------------------------------------------------------------
# `null` is the default and a working configuration: the kitchen display and
# the live-orders board poll, exactly as they always have.
#
# Set this to `reverb`, fill in the three values below and run
#   php artisan reverb:start
# to make those screens instant. They keep polling on a slow heartbeat, so a
# socket server that dies costs latency rather than tickets.
#
# Not available on shared hosting that forbids long-running processes — which
# is why it is off by default rather than assumed.
BROADCAST_CONNECTION=null

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# ----------------------------------------------------------------------------
# Sending a text message (§3.8 — the optional OTP step)
# ----------------------------------------------------------------------------
# `log` writes the code to the log instead of sending it, which is enough to
# try the whole flow with no provider account. Switch to `http` and point it
# at any provider — MSG91, Fast2SMS, Textlocal, Kaleyra — by naming their
# parameters below. See config/sms.php.
SMS_DRIVER=log
# SMS_HTTP_URL=
# SMS_HTTP_TO_FIELD=mobiles
# SMS_HTTP_MESSAGE_FIELD=message
# SMS_HTTP_PARAMS='{"authkey":"...","sender":"RESTRO","route":"4"}'
# SMS_HTTP_HEADERS='{"Authorization":"..."}'

# ----------------------------------------------------------------------------
# WhatsApp (§2, §15)
# ----------------------------------------------------------------------------
# `log` writes the message to the log and sends nothing, which is enough to
# try the whole flow with no Meta account.
#
# WhatsApp is not an open channel: a business may only START a conversation
# with a template Meta has approved. That is Meta's rule, not a provider's,
# so every message here carries a template name. See config/whatsapp.php.
#
#   cloud  Meta's own API. Free, but needs a Meta Business account.
#   http   any Indian reseller - Gupshup, AiSensy, Interakt, Wati.
WHATSAPP_DRIVER=log

# WHATSAPP_PHONE_NUMBER_ID=   # NOT the phone number - the id beside it in Meta's dashboard
# WHATSAPP_TOKEN=
# WHATSAPP_LANGUAGE=en        # "en" and "en_US" are different templates to Meta

# WHATSAPP_HTTP_URL=
# WHATSAPP_HTTP_PARAMS='{"apikey":"..."}'
