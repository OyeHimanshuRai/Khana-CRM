# ============================================================================
# Production settings for the live SaaS server.
#
# Copy to `.env` on the server, fill in every <...>, then run:
#   php artisan key:generate        (first deploy only)
#   php artisan migrate --force
#   php artisan optimize
#
# Never commit the filled-in copy. See docs/DEPLOYMENT.md.
# ============================================================================

APP_NAME="<Your Brand> POS"
APP_ENV=production
APP_KEY=
# Must stay false: true prints stack traces, SQL and config to any visitor.
APP_DEBUG=false
APP_URL=https://<your-domain.com>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# A dedicated user with rights on this one database - never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_pos
DB_USERNAME=pos_app
DB_PASSWORD=<strong-random-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS only, so a session cookie never travels in clear text.
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# Redis if the server has it (faster); `database` works without it.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=pos_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real mail - Amazon SES, Zoho, Brevo, or the host's SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp.host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="no-reply@<your-domain.com>"
MAIL_FROM_NAME="${APP_NAME}"

# The first Super Admin, used by `db:seed` on a fresh server only.
ADMIN_EMAIL=<you@your-domain.com>
ADMIN_PASSWORD=<strong-password-change-after-first-login>

# ----------------------------------------------------------------------------
# Money: two Razorpay accounts, deliberately separate (config/payments.php)
# ----------------------------------------------------------------------------
# Restaurants' guests paying their bill:
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY=<rzp_live_...>
RAZORPAY_SECRET=<...>
RAZORPAY_WEBHOOK_SECRET=<...>      # webhook URL: https://<your-domain.com>/payments/webhook

# Restaurants paying YOU for their subscription:
PLATFORM_RAZORPAY_KEY=<rzp_live_...>
PLATFORM_RAZORPAY_SECRET=<...>
PLATFORM_RAZORPAY_WEBHOOK_SECRET=<...>   # webhook URL: https://<your-domain.com>/billing/webhook

# Printed on the subscription invoices you issue.
BILLING_COMPANY_NAME="<Your Company Pvt Ltd>"
BILLING_COMPANY_ADDRESS="<Registered address>"
BILLING_COMPANY_GSTIN=<GSTIN>
BILLING_COMPANY_EMAIL=<billing@your-domain.com>

# ----------------------------------------------------------------------------
# Messages. `log` sends nothing; switch once the provider is DLT-registered.
# ----------------------------------------------------------------------------
SMS_DRIVER=http
# SMS_HTTP_URL=
# SMS_HTTP_TO_FIELD=mobiles
# SMS_HTTP_MESSAGE_FIELD=message
# SMS_HTTP_PARAMS='{"authkey":"...","sender":"RESTRO","route":"4"}'

WHATSAPP_DRIVER=cloud
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_LANGUAGE=en

REMINDERS_ENABLED=true
REMINDERS_SMS_ENABLED=false
REMINDERS_WHATSAPP_ENABLED=false

# Browser push to the kitchen/counter: `php artisan push:keys` prints these.
PUSH_ENABLED=false
# PUSH_SUBJECT=mailto:support@<your-domain.com>
# PUSH_PUBLIC_KEY=
# PUSH_PRIVATE_KEY=

# Instant kitchen screens. `null` polls and works everywhere.
BROADCAST_CONNECTION=null

BACKUP_KEEP=14
